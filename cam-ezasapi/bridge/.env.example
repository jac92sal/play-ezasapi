# Shared secret between the Worker and this bridge.
# Generate with:  openssl rand -hex 32
# The same value goes into the Worker as the BRIDGE_TOKEN secret.
BRIDGE_TOKEN=

# From: Cloudflare dashboard > Zero Trust > Networks > Tunnels > Create a tunnel
# Route the tunnel's public hostname (e.g. bridge.ezasapi.com) to http://localhost:8080
TUNNEL_TOKEN=

# R2 API token with Object Read & Write on the cam-recordings bucket.
# Cloudflare dashboard > R2 > Manage API Tokens
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://890f43004f700d06eade9fd5147c8aa5.r2.cloudflarestorage.com
